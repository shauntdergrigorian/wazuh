<group name="syscheck,ransomware_detection,generic_rule,">
  <!-- Frequency rule: Triggers when 50 FIM events match on the same agent within 5 seconds -->
  <rule id="100057" level="12" frequency="50" timeframe="5" ignore="60">
    <if_matched_group>syscheck</if_matched_group>
    <description>Possible Ransomware / Rapid File Modification: Over 50 file changes or renames detected in under 5 seconds on $(agent.name).</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>
</group>

